# Dados PÚBLICOS do site, injetados no index.html no build (%VITE_...%).
# Este arquivo vai para o Git e tudo aqui aparece no HTML do site: nunca coloque
# senhas, tokens ou chaves. Segredos vão no .env.local (ignorado pelo Git) ou nas
# variáveis de ambiente da Vercel, que têm prioridade sobre este arquivo.
# Troque os valores marcados com TODO pelos dados reais do Victor.

# TODO: domínio definitivo (sem barra no final)
VITE_SITE_URL=https://victoroliveirapersonal.com.br
# TODO: WhatsApp só com dígitos: 55 + DDD + número
VITE_WHATSAPP=5527999999999
# TODO: telefone formatado para exibição e para o Google
VITE_PHONE_DISPLAY=+55 27 99999-9999
# TODO: número do CREF (ex.: 000000-G/ES)
VITE_CREF=000000-G/ES
VITE_INSTAGRAM=https://www.instagram.com/victoroliveira.personal/
